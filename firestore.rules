rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the verified Admin (lovishmanchanda719@gmail.com)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "lovishmanchanda719@gmail.com" ||
        request.auth.token.admin == true
      );
    }
    
    // Helper function to check if the reaction belongs to the current user
    function isUserReaction(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to validate review data (allows guest & logged-in user reviews with anti-spam bounds)
    function isValidReview() {
      let data = request.resource.data;
      return data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 100 &&
             data.rating is number &&
             data.rating >= 1 &&
             data.rating <= 5 &&
             data.comment is string &&
             data.comment.size() > 0 &&
             data.comment.size() <= 1500 &&
             data.likes is number &&
             data.likes == 0 &&
             data.dislikes is number &&
             data.dislikes == 0 &&
             data.userId is string &&
             data.userId.size() > 0 &&
             data.userId.size() <= 128 &&
             data.location is string &&
             data.location.size() <= 100;
    }

    // Validate booking data with strict type & length limits
    function isValidBooking() {
      let data = request.resource.data;
      return data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 100 &&
             data.phone is string &&
             data.phone.size() >= 10 &&
             data.phone.size() <= 15 &&
             data.preferredDate is string &&
             data.preferredDate.size() <= 30 &&
             data.preferredTime is string &&
             data.preferredTime.size() <= 30;
    }

    // Validate analytics event payload (write-only privacy-safe telemetry)
    function isValidAnalyticsEvent() {
      let data = request.resource.data;
      return data.eventName is string &&
             data.eventName.size() > 0 &&
             data.eventName.size() <= 60 &&
             data.path is string &&
             data.path.size() <= 200 &&
             data.visitorId is string &&
             data.visitorId.size() <= 100;
    }

    // Videos collection (Public Read, Admin-Only Write)
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Photos collection (Public Read, Admin-Only Write)
    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection (Strict Owner-Only Access + Admin)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
    
    // Articles collection (Preserved from original rules)
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && request.auth.token.role == 'editor');
    }
    
    // Messages collection (Preserved from original rules, strict sender/receiver check)
    match /messages/{messageId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId;
      allow update, delete: if isAdmin();
    }
    
    // Reviews collection (Allows ANY visitor to read & publish validated reviews)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidReview();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes'])
      );
      allow delete: if isAdmin();
    }
    
    // Bookings collection (Owner or Admin can read; Validated create; Owner can set bookingId; Admin full control)
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidBooking();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingId']))
      );
      allow delete: if isAdmin();
    }

    // UserReactions collection (Preserved from original rules - Strict Owner-Only Access)
    match /userReactions/{reactionId} {
      allow read: if isAuthenticated() 
        && reactionId.matches(request.auth.uid + "_.*");
      allow create, update: if isAuthenticated() 
        && reactionId.matches(request.auth.uid + "_.*")
        && request.resource.data.keys().hasOnly(['liked', 'disliked']);
      allow delete: if isAdmin();
    }

    // Feedback collection (Preserved from original rules, secured so only owner/admin can read/modify)
    match /feedback/{feedbackId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.userId);
    }

    // SiteAnalytics collection (Write-Only Telemetry for Visitors, Admin-Only Read/Delete)
    match /siteAnalytics/{eventId} {
      allow create: if isValidAnalyticsEvent();
      allow read, update, delete: if isAdmin();
    }

    // IMPORTANT: Default deny-all fallback (Replaces the dangerous `allow read, write: if isAuthenticated()` wildcard)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
